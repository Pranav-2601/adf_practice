{
	"name": "api_adls_pipeline",
	"properties": {
		"activities": [
			{
				"name": "Copy data1",
				"type": "Copy",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "RestSource",
						"httpRequestTimeout": "00:01:40",
						"requestInterval": "00.00:00:00.010",
						"requestMethod": "GET",
						"paginationRules": {
							"supportRFC5988": "true"
						}
					},
					"sink": {
						"type": "DelimitedTextSink",
						"storeSettings": {
							"type": "AzureBlobFSWriteSettings"
						},
						"formatSettings": {
							"type": "DelimitedTextWriteSettings",
							"quoteAllText": true,
							"fileExtension": ".txt"
						}
					},
					"enableStaging": false,
					"translator": {
						"type": "TabularTranslator",
						"mappings": [
							{
								"source": {
									"path": "['id']"
								},
								"sink": {
									"ordinal": 1
								}
							},
							{
								"source": {
									"path": "['collection_id']"
								},
								"sink": {
									"ordinal": 2
								}
							},
							{
								"source": {
									"path": "['project_id']"
								},
								"sink": {
									"ordinal": 3
								}
							},
							{
								"source": {
									"path": "['created_by']"
								},
								"sink": {
									"ordinal": 4
								}
							},
							{
								"source": {
									"path": "['created_at']"
								},
								"sink": {
									"ordinal": 5
								}
							},
							{
								"source": {
									"path": "['updated_at']"
								},
								"sink": {
									"ordinal": 6
								}
							},
							{
								"source": {
									"path": "['data']['name']"
								},
								"sink": {
									"ordinal": 7
								}
							},
							{
								"source": {
									"path": "['data']['price']"
								},
								"sink": {
									"ordinal": 8
								}
							},
							{
								"source": {
									"path": "['data']['category']"
								},
								"sink": {
									"ordinal": 9
								}
							},
							{
								"source": {
									"path": "['data']['in_stock']"
								},
								"sink": {
									"ordinal": 10
								}
							}
						],
						"collectionReference": "$['data']",
						"mapComplexValuesToString": false
					}
				},
				"inputs": [
					{
						"referenceName": "RestResource1",
						"type": "DatasetReference"
					}
				],
				"outputs": [
					{
						"referenceName": "DelimitedText3",
						"type": "DatasetReference"
					}
				]
			}
		],
		"annotations": []
	}
}